# Volaille Manager — environment variables
# Copy to .env.local for local development. NEVER commit real values.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable key (sb_publishable_...) — or the legacy anon key.
# This key is public by design; data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# The service-role / secret key is NOT used by this application. Do not add it.

# Only for running the database integration tests against a local PostgreSQL server:
# TEST_DATABASE_ADMIN_URL=postgresql://postgres@localhost:54329/postgres
